#include <iostream>
using namespace std;
int main()
{
    int x=42;
    int *ptr;
    ptr = &x;
    cout<<"Value of x: "<<*ptr<<endl;
    cout<<"Address of x: "<<ptr<<endl;
    cout<<"value of ptr (address of x): "<<ptr<<endl;
    cout<<"value at address ptr: "<<x<<endl;
    *ptr = 100;
    cout<<"New value of x: "<<x<<endl;
    int* nullptr = nullptr;
    return 0;
}